{
  "name": "family-tree-app",
  "private": true,
  "description": "Monorepo for the Family Tree App",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@family-tree/server --filter=@family-tree/web",
    "lint": "turbo lint",
    "test": "npm run test -w @family-tree/server && npm run test -w @family-tree/web",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "npm run db:generate -w @family-tree/database",
    "db:push": "npm run db:push -w @family-tree/database",
    "db:migrate": "npm run db:migrate -w @family-tree/database",
    "db:seed": "npm run db:seed -w @family-tree/database",
    "docker:up": "powershell -ExecutionPolicy Bypass -File ./scripts/docker-up.ps1",
    "docker:down": "docker compose down",
    "docker:up:remote-db": "powershell -ExecutionPolicy Bypass -File ./scripts/docker-up-remote-db.ps1"
  },
  "devDependencies": {
    "turbo": "^2.8.20",
    "prettier": "^3.8.1"
  }
}
