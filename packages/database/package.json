{
  "name": "@family-tree/database",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "postinstall": "node scripts/link-prisma-client.js && prisma generate || exit 0",
    "build": "node scripts/link-prisma-client.js && prisma generate && tsc",
    "db:generate": "node scripts/link-prisma-client.js && prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^6.0.0",
    "prisma": "5.22.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
